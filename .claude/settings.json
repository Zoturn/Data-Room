{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/spec-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"",
            "async": true,
            "timeout": 120,
            "statusMessage": "Formatting with Prettier..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/test-companion.sh\"",
            "timeout": 15,
            "statusMessage": "Checking test coverage for the change..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/post-commit-tests.sh\"",
            "timeout": 300,
            "statusMessage": "Running Jest for the committed workspaces..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-sync.sh\"",
            "timeout": 120,
            "statusMessage": "Verifying documentation after archive..."
          }
        ]
      }
    ]
  }
}
