# Copy to apps/api/.env and fill in. The API validates these at boot and exits
# non-zero if one is missing or malformed — it never starts half-configured.

NODE_ENV=development
PORT=3001

# Supabase connection strings. DATABASE_URL is the pooled one used at runtime;
# DIRECT_URL is the direct one, which `prisma migrate` needs because migrations
# require a session and the pooler runs in transaction mode.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Where the browser app runs
WEB_APP_URL=http://localhost:3000

# Comma-separated origins allowed to send credentialed requests
CORS_ORIGINS=http://localhost:3000

# Cookie policy. Local defaults below; production sets true / none, which
# requires HTTPS on both origins.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
