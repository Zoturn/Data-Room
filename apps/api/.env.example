# Copy to apps/api/.env and fill in. The API validates these at boot and exits
# non-zero if one is missing or malformed — it never starts half-configured.

NODE_ENV=development
PORT=3001

# Supabase connection strings. DATABASE_URL is the pooled one used at runtime;
# DIRECT_URL is the direct one, which `prisma migrate` needs because migrations
# require a session and the pooler runs in transaction mode.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Where the browser app runs
WEB_APP_URL=http://localhost:3000

# Comma-separated origins allowed to send credentialed requests
CORS_ORIGINS=http://localhost:3000

# Access-token signing key. At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-at-least-32-random-characters

# Token lifetimes, in seconds. Defaults shown; the cookie maxAge and the token exp are both
# derived from these, so they cannot drift apart.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Grace window in which a just-rotated refresh token still works, so a client's own parallel
# requests are not mistaken for a stolen-token replay.
REFRESH_ROTATION_GRACE_SECONDS=10

# The longest one sign-in may live regardless of rotation. The refresh TTL above is an idle
# timeout and slides forward on every use; this is the bound that eventually forces a real
# sign-in, and the reason a stolen refresh token cannot be renewed forever.
ABSOLUTE_SESSION_MAX_SECONDS=2592000

# Cookie policy. Local defaults below; production sets true / none, which
# requires HTTPS on both origins.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
